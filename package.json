{
  "name": "geoapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content:refresh": "tsx scripts/refresh-mvp-content.ts",
    "content:refresh:physical": "tsx scripts/refresh-physical-content.ts",
    "content:refresh:knowledge": "tsx scripts/refresh-knowledge-content.ts",
    "content:refresh:cities": "tsx scripts/refresh-ranked-cities.ts",
    "content:refresh:ranked-physical": "tsx scripts/refresh-ranked-physical.ts",
    "content:build": "tsx scripts/build-visual-assets.ts && tsx scripts/build-content.ts",
    "build": "npm run content:build && tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run content:build && npm run typecheck && npm run test && vite build"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.111.0",
    "lucide-react": "0.468.0",
    "maplibre-gl": "5.24.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "topojson-client": "3.1.0",
    "world-atlas": "2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@types/node": "22.19.3",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitejs/plugin-react": "5.1.2",
    "flag-icons": "7.5.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "3.2.7",
    "world-countries": "5.1.0"
  }
}
